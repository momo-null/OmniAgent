{
  "name": "bilibili",
  "version": "1.0.0",
  "title": "B站只读采集",
  "description": "B站只读工具集（热门/搜索/视频信息/评论区/自己动态数据），供外环语料采集与先读再评使用。零写操作——平台写路径单点收口在 bilibili 通道适配器。",
  "enabled": true,
  "permissions": [
    "network"
  ],
  "events": {
    "transport": "pull",
    "factory": "channel:build"
  },
  "lifecycle": {
    "autostart": true,
    "health": {
      "probe": "ready"
    },
    "spawn": {
      "args": [
        "-m",
        "plugins.bilibili.page_server"
      ],
      "cwd": "{repo}",
      "port": 18751,
      "health": "/healthz"
    }
  },
  "requires": {
    "host": [
      "subscribe_events",
      "reply_handle",
      "config",
      "log"
    ]
  },
  "ui": [
    {
      "id": "outbox",
      "label": "出站审批",
      "icon": "blocks",
      "slot": "dock",
      "url": "http://127.0.0.1:18751/"
    }
  ]
}
