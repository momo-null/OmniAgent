// ============================================================================
// OmniAgent 定时任务模板 → 拷到 ~/.omniagent/cron/jobs.json
//
// 谁来读：网关调度器（gateway/channel_gateway.py 拉起 scheduler，**每 tick 重读本文件**
//         → 改完不用重启）；Web「定时任务」页做的是同一份文件的 CRUD。
// 同目录兄弟文件（都由程序写，不要手改、也不用准备模板）：
//   state.json  每个 job 上次触发的分钟键（防同一分钟重复触发）
//   runs.jsonl  运行记录（页面里的历史与失败原因来自这里）
//
// ⚠ 防化石铁律：objective 只许一句话，且**禁止**出现路径 / 脚本名 / 数据源
//   （校验函数会拦下含 "D:\" "D:/" "python" ".py" "/mnt/" "http" 的 objective）。
//   理由：把流程细节写死在 cron 里就成了没人敢动的化石任务——具体怎么做由
//   objective 里指向的 MCP server / 技能单点供给，这里只交代「做什么」。
// 注释：  // 只有读取端认；定时任务页保存会重写成无注释版本。
// ============================================================================
{
  "jobs": [
    {
      // id 全局唯一，是 state.json 里的记账键；改名 = 丢历史，尽量别改
      "id": "morning-brief",
      // name 只给人看（页面标题、日志）
      "name": "早报摘要",
      // 标准 5 字段 cron：分 时 日 月 周（周日 = 0 或 7）。支持 * , - /
      // 注意语义：「日」和「周」同时限定时取**并集**（跟标准 cron 一致，不是交集）
      "cron": "0 8 * * 1-5",
      // 一句话任务描述（模型收到的 objective 原文）。写「做什么」，不写「怎么做」。
      "objective": "生成今日早报摘要并发给我",
      // 完成判据（可选）。留空最安全：让工具返回自证。
      // ⚠ 别填「已落盘 / 已写入某文件」这类条件——完成校验器看不到外部副作用，
      //   填了 agent 会为了自证把步数预算耗光后判失败。
      "done_when": "",
      // 步数预算：耗尽即失败（budget_exhausted），不是「差不多就收」
      "max_steps": 40,
      // 关联项目：决定用哪个项目目录 + 哪份项目级 AGENTS.md（纪律文件），
      // 轨迹也按项目落盘。留空 = 临时任务，跑完即清理。
      "project_id": "demo-project",
      // 结果推送到哪条通道（channels/<name>.yaml 的文件名，如 napcat / feishu）。
      // 投递目标是该通道配置里的 default_chat_id 广播；留空 = 只落运行记录不外发。
      // 想发到指定会话就在对应通道 yaml 里设 default_chat_id，而不是在这里写会话号。
      "notify_channel": "napcat",
      // 出厂建议 false：装好后在页面上按需启用（本文件是运行真源，手改也生效）
      "enabled": false,
      // 错过补偿：进程没跑时错过触发点，启动回扫最近一次触发点，
      // 在 miss_grace_minutes 分钟内补跑一次（超过就放弃，避免开机补跑一堆陈任务）
      "miss_grace_minutes": 60,
      // 备注：只进页面/文件，不参与执行。写清「为什么这么设」比写流程更有用
      "note": "示例任务；启用前先确认通道与模型都已配置"
    },

    // 第二个条目演示最小可用形态：只填必填三项 + enabled
    {
      "id": "weekly-note",
      "name": "周记整理",
      "cron": "30 21 * * 0",
      "objective": "把本周的记忆原子整理成周记要点",
      "enabled": false,
      "max_steps": 20,
      "miss_grace_minutes": 180
    }
  ]
}
